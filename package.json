{
  "name": "3xui-mcp",
  "version": "0.1.1",
  "description": "MCP server exposing 3x-ui panel read operations and inbound/client CRUD to LLM agents, built on 3xui-api-client",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "3xui-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3x-ui",
    "3xui",
    "xray",
    "vpn"
  ],
  "author": {
    "name": "Helitha Guruge",
    "url": "https://github.com/iamhelitha"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamhelitha/3xui-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/iamhelitha/3xui-mcp/issues"
  },
  "homepage": "https://github.com/iamhelitha/3xui-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "3xui-api-client": "^3.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
